      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10008, "listen": "127.0.0.1", "protocol": "vless", "tag": "vless-xh",
      "settings": {"clients": [{"id": "saeka", "level": 0}], "decryption": "none"},
      "streamSettings": {"network": "xhttp", "xhttpSettings": {"path": "/vless-saeka-xh", "mode": "auto"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
