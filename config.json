    {
      "port": 10014, "listen": "127.0.0.1", "protocol": "vless", "tag": "vless-grpc",
      "settings": {"clients": [{"id": "saeka", "level": 0}], "decryption": "none"},
      "streamSettings": {"network": "grpc", "grpcSettings": {"serviceName": "vless-saeka-grpc"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10009, "listen": "127.0.0.1", "protocol": "shadowsocks", "tag": "ss-ws",
      "settings": {"clients": [{"password": "saeka", "method": "aes-256-gcm", "level": 0}]},
      "streamSettings": {"network": "ws", "wsSettings": {"path": "/ss-saeka"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}}
    },
    {
      "port": 10010, "listen": "127.0.0.1", "protocol": "shadowsocks", "tag": "ss-hu",
      "settings": {"clients": [{"password": "saeka", "method": "aes-256-gcm", "level": 0}]},
      "streamSettings": {"network": "httpupgrade", "httpupgradeSettings": {"path": "/ss-saeka-hu"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}}
    },
    {
      "port": 10011, "listen": "127.0.0.1", "protocol": "shadowsocks", "tag": "ss-xh",
      "settings": {"clients": [{"password": "saeka", "method": "aes-256-gcm", "level": 0}]},
      "streamSettings": {"network": "xhttp", "xhttpSettings": {"path": "/ss-saeka-xh", "mode": "auto"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}}
    },
    {
      "port": 10015, "listen": "127.0.0.1", "protocol": "shadowsocks", "tag": "ss-grpc",
      "settings": {"clients": [{"password": "saeka", "method": "aes-256-gcm", "level": 0}]},
      "streamSettings": {"network": "grpc", "grpcSettings": {"serviceName": "ss-saeka-grpc"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}}
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": { "domainStrategy": "UseIPv4" }
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["trojan-ws", "trojan-hu", "trojan-xh", "trojan-grpc", "vmess-ws", "vmess-hu", "vmess-xh", "vmess-grpc", "vless-ws", "vless-hu", "vless-xh", "vless-grpc", "ss-ws", "ss-hu", "ss-xh", "ss-grpc"],
        "outboundTag": "direct"
      }
    ]
  }
}
