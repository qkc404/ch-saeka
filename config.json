{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": ["8.8.8.8", "1.1.1.1"],
    "queryStrategy": "UseIPv4",
    "disableCache": false
  },
  "assets": {
    "directory": "/usr/local/share/xray/"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 2,
        "connIdle": 3600,
        "bufferSize": 1048576
      }
    }
  },
  "inbounds": [
    {
      "port": 10000, "listen": "127.0.0.1", "protocol": "trojan", "tag": "trojan-ws",
      "settings": {"clients": [{"password": "saeka", "level": 0}]},
      "streamSettings": {"network": "ws", "wsSettings": {"path": "/saeka-tojirp"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10001, "listen": "127.0.0.1", "protocol": "trojan", "tag": "trojan-hu",
      "settings": {"clients": [{"password": "saeka", "level": 0}]},
      "streamSettings": {"network": "httpupgrade", "httpupgradeSettings": {"path": "/saeka-tojirp-hu"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10002, "listen": "127.0.0.1", "protocol": "trojan", "tag": "trojan-xh",
      "settings": {"clients": [{"password": "saeka", "level": 0}]},
      "streamSettings": {"network": "xhttp", "xhttpSettings": {"path": "/saeka-tojirp-xh", "mode": "auto"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10012, "listen": "127.0.0.1", "protocol": "trojan", "tag": "trojan-grpc",
      "settings": {"clients": [{"password": "saeka", "level": 0}]},
      "streamSettings": {"network": "grpc", "grpcSettings": {"serviceName": "saeka-tojirp-grpc"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10003, "listen": "127.0.0.1", "protocol": "vmess", "tag": "vmess-ws",
      "settings": {"clients": [{"id": "saeka", "alterId": 0, "level": 0}]},
      "streamSettings": {"network": "ws", "wsSettings": {"path": "/vmess-saeka"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10004, "listen": "127.0.0.1", "protocol": "vmess", "tag": "vmess-hu",
      "settings": {"clients": [{"id": "saeka", "alterId": 0, "level": 0}]},
      "streamSettings": {"network": "httpupgrade", "httpupgradeSettings": {"path": "/vmess-saeka-hu"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10005, "listen": "127.0.0.1", "protocol": "vmess", "tag": "vmess-xh",
      "settings": {"clients": [{"id": "saeka", "alterId": 0, "level": 0}]},
      "streamSettings": {"network": "xhttp", "xhttpSettings": {"path": "/vmess-saeka-xh", "mode": "auto"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10013, "listen": "127.0.0.1", "protocol": "vmess", "tag": "vmess-grpc",
      "settings": {"clients": [{"id": "saeka", "alterId": 0, "level": 0}]},
      "streamSettings": {"network": "grpc", "grpcSettings": {"serviceName": "vmess-saeka-grpc"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10006, "listen": "127.0.0.1", "protocol": "vless", "tag": "vless-ws",
      "settings": {"clients": [{"id": "saeka", "level": 0}], "decryption": "none"},
      "streamSettings": {"network": "ws", "wsSettings": {"path": "/vless-saeka"}, "sockopt": {"tcpFastOpen": true, "tcpNoDelay": true, "tcpKeepAliveIdle": 300, "tcpKeepAliveInterval": 30}},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "port": 10007, "listen": "127.0.0.1", "protocol": "vless", "tag": "vless-hu",
      "settings": {"clients": [{"id": "saeka", "level": 0}], "decryption": "none"},
